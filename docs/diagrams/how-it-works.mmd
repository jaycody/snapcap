flowchart TD
    A["setup: new Snapcap with your project name"] --> G["Ask git for the version<br/>for example v1.1.0-2-g47fc45b-dirty<br/>or nogit if git is not found"]
    G --> CF["Read snapcap.json if there is one<br/>folders, keys, format, overlay"]
    CF --> R["Register hooks with Processing<br/>registerMethod draw, keyEvent and dispose"]

    subgraph EVERY ["Every frame, automatically"]
        D1["Your draw makes the art"] --> D2["Snapcap draw runs right after"]
        D2 --> Q{"Recording?"}
        Q -->|yes| ST{"Storage reachable?<br/>link or drive there"}
        ST -->|yes| CP["Copy the screen<br/>and name the frame"]
        ST -->|no| CL["Copy the screen, aim it at frames_local<br/>and warn on screen"]
        CP --> QF{"Write queue full?<br/>30 frames waiting"}
        CL --> QF
        QF -->|no| EN["Hand the copy to the queue<br/>draw moves on at full speed"]
        QF -->|"yes, disk is behind"| SELF["draw writes this frame itself<br/>slower, but no frame is dropped"]
        Q -->|no| OV["Draw the REC overlay<br/>after the copy, so it is never captured"]
        EN --> OV
        SELF --> OV
    end

    subgraph WRITERS ["Writer threads"]
        W["Take the next copy from the queue<br/>encode the image and write the file"]
    end

    subgraph KEYS ["On every key press"]
        K{"Which key?"}
        K -->|r| T["Start or stop a take<br/>new folder named by its start time"]
        K -->|ENTER| S["Copy the screen as a snap<br/>to snaps_local if storage is offline"]
        K -->|d or i| H["Toggle overlay or print key list"]
    end

    X["Sketch closes: dispose<br/>finish every queued write first"]

    R --> D1
    R --> K
    T -.->|switches recording| Q
    EN -.-> W
    S -.->|same queue| W
    X -.->|waits for| W

    W --> FR[("frames / VERSION / TAKE START TIME /<br/>TIME-FRAMECOUNT.tif")]
    W --> FL[("frames_local / same folders")]
    W --> SN[("snaps / VERSION /<br/>PROJECT-TIME-MILLIS-VERSION.tif")]
